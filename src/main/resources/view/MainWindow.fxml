<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="600.0" prefWidth="400.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="recordbase.ui.MainWindowController">
    <children>
        <!-- Note, both textfield and button needs to have a action handler. This is to handle the "Enter" button press. -->
        <TextField fx:id="userInput" layoutY="558.0" onAction="#handleSendUserInput" onKeyPressed="#handleUpDownKeyPress" prefHeight="41.0" prefWidth="324.0" AnchorPane.bottomAnchor="1.0" />
        <Button fx:id="sendButton" layoutX="324.0" layoutY="558.0" mnemonicParsing="false" onAction="#handleSendUserInput" prefHeight="41.0" prefWidth="76.0" text="Send" />
        <ScrollPane fx:id="scrollPane" hbarPolicy="NEVER" hvalue="1.0" prefHeight="475.0" prefWidth="400.0" vvalue="1.0">
            <content>
                <VBox fx:id="dialogContainer" prefHeight="399.0" prefWidth="401.0" />
            </content>
        </ScrollPane>
      <Button fx:id="listItemsBtn" layoutX="14.0" layoutY="494.0" mnemonicParsing="false" onAction="#handleButtonListItems" prefHeight="54.0" prefWidth="93.0" text="List" />
    </children>
</AnchorPane>
